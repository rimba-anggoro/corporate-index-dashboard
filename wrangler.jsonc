
{
  "$schema": "https://schema.cloudflare.com/wrangler/config-schema.json",
  "name": "corporate-index-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corpindex-db",
      "database_id": "254bcfc1-c46e-4092-b2c7-97b10ffd8b35"
    }
  ]
}
